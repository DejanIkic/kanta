[Unit]
Description=SmartBin FastAPI service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dejan/Desktop/kanta/rpi-pico-servo-python
ExecStart=/home/dejan/Desktop/kanta/rpi-pico-servo-python/venv/bin/python -m uvicorn rpi_api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
